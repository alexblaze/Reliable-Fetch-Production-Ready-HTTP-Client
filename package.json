{
  "name": "steadyfetch",
  "version": "0.1.0",
  "description": "A safe, configurable HTTP client with retries, timeouts, rate limiting, and concurrency controls, built on the standard Fetch API.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "fetch",
    "http",
    "retry",
    "timeout",
    "backoff",
    "rate-limit",
    "concurrency",
    "abort"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexblaze/Reliable-Fetch-Production-Ready-HTTP-Client.git"
  },
  "bugs": {
    "url": "https://github.com/alexblaze/Reliable-Fetch-Production-Ready-HTTP-Client/issues"
  },
  "homepage": "https://github.com/alexblaze/Reliable-Fetch-Production-Ready-HTTP-Client#readme",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "verify:pack": "node scripts/verify-pack.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
